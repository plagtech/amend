# Amend — environment variables
# Copy to `.env` for local dev. On Railway, set these in the service Variables tab.
# `.env` is gitignored — never commit real secrets.

# --- Shopify app credentials (from Partners dashboard / `shopify app config link`) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated. Must match shopify.app.toml access_scopes.
SCOPES=read_products,write_products
# Public URL of the app (tunnel URL in dev, Railway domain in prod).
SHOPIFY_APP_URL=

# --- Database (Postgres) ---
# Local: postgresql://USER:PASSWORD@localhost:5432/amend
# Railway: provided automatically by the Postgres plugin as ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# --- Seed script (scripts/seed-products.ts, dev stores only) ---
# Mint these in the dev store: Settings → Apps and sales channels →
# Develop apps → create an app with read_products + write_products, install
# it, then copy the Admin API access token.
SEED_SHOP_DOMAIN=
SEED_ADMIN_TOKEN=

# --- Optional ---
# Set when testing against a non-myshopify custom store domain.
# SHOP_CUSTOM_DOMAIN=
