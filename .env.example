# Amend — environment variables
# Copy to `.env` for local dev. On Railway, set these in the service Variables tab.
# `.env` is gitignored — never commit real secrets.

# --- Shopify app credentials (from Partners dashboard / `shopify app config link`) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated. Must match shopify.app.toml access_scopes.
SCOPES=read_products,write_products
# Public URL of the app (tunnel URL in dev, Railway domain in prod).
SHOPIFY_APP_URL=

# --- Database (Postgres on Railway) ---
# IMPORTANT: Railway exposes the Postgres service under two different URLs.
#
#   DATABASE_URL        postgresql://postgres:PASS@postgres.railway.internal:5432/railway
#                       Private network. Only resolves from inside Railway.
#                       Use this for the DEPLOYED service (reference it as
#                       ${{ Postgres.DATABASE_URL }} in the Amend service's Variables tab).
#
#   DATABASE_PUBLIC_URL postgresql://postgres:PASS@HOST.proxy.rlwy.net:PORT/railway
#                       TCP proxy, reachable from anywhere.
#                       Use this for LOCAL dev in this file — the internal
#                       hostname will fail with "getaddrinfo ENOTFOUND" off-Railway.
#
# So: put the PUBLIC url here, and the INTERNAL one in Railway's own Variables tab.
DATABASE_URL=

# --- Seed script (scripts/seed-products.ts, dev stores only) ---
# Mint these in the dev store: Settings → Apps and sales channels →
# Develop apps → create an app with read_products + write_products, install
# it, then copy the Admin API access token.
SEED_SHOP_DOMAIN=
SEED_ADMIN_TOKEN=

# --- Scheduler (Phase 6) ---
# The web process runs an in-process timer that fires scheduled edits, closes
# sale windows at revertAt, and sweeps stalled jobs. It starts automatically.
#
# SCHEDULER_DISABLED=1   turn it off entirely. Set this on any *second* web
#                        instance: the claims are safe under concurrency, but
#                        one ticker is all this deploy needs.
# SCHEDULER_TICK_MS=30000  how often it looks. Minimum 1000. The verification
#                        scripts set this themselves; leave it unset in prod.

# --- Billing ---
# Charges are created as test charges automatically on development stores and
# whenever NODE_ENV is not "production". Set BILLING_TEST=1 to force test
# charges anywhere else — never set it on a production deploy serving real
# merchants, or nobody will ever be billed.
# BILLING_TEST=1

# --- Optional ---
# Set when testing against a non-myshopify custom store domain.
# SHOP_CUSTOM_DOMAIN=
