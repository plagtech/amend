// Amend — Shopify Bulk Product Editor
// Prisma schema. Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Postgres on Railway. Local dev also points at a Postgres instance via DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Session table required by @shopify/shopify-app-session-storage-prisma.
// Do not remove or rename fields — the library manages this shape.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            String    @id                  // shop domain, e.g. my-store.myshopify.com
  plan          String    @default("free")     // free | pro (advanced reserved for v1.1)
  jobsThisMonth Int       @default(0)
  cycleStart    DateTime  @default(now())      // job counter resets at cycleStart + 30 days
  active        Boolean   @default(true)       // set false on app/uninstalled
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
}

model EditJob {
  id           String     @id @default(cuid())
  shopId       String
  name         String                          // auto: "Price -10% on Summer collection"
  filterJson   Json                            // the SELECT criteria
  actionsJson  Json                            // ordered list of edit actions
  status       String     @default("draft")    // draft|queued|snapshotting|running|completed|failed|undone
  scheduledFor DateTime?
  revertAt     DateTime?                        // optional auto-revert (sale windows)
  totalItems   Int        @default(0)
  failedItems  Int        @default(0)
  bulkOpGid    String?                          // Shopify bulk operation ID
  undoOfJobId  String?                          // set if this job is an undo
  createdAt    DateTime   @default(now())
  completedAt  DateTime?
  snapshots    Snapshot[]

  // The browser is handed this with its preview and sends it back with Apply,
  // so a confirm POST that arrives twice — a retried fetch, a second tab, a
  // double-submit — resolves to the job the first one created instead of
  // queueing a duplicate edit that compounds on it. Nullable: undo and retry
  // jobs are not created from a preview, and neither is any pre-existing row.
  idempotencyKey String?  @unique
  // Last write to this row. `heartbeatAt` only moves while a job is actively
  // running, so it cannot tell a freshly queued job from one orphaned by a
  // process that died before claiming the slot. This can.
  updatedAt      DateTime @updatedAt @default(now())

  // --- Phase 4: the job engine ---------------------------------------------
  // How the mutations run. "sync" batches them inline; "bulk" stages a JSONL
  // upload and waits on the bulk_operations/finish webhook.
  mode         String     @default("sync")     // sync|bulk
  // Bulk runs one mutation type at a time, so a job with both variant and
  // product edits runs two sequential bulk operations. This is the one in
  // flight — see MUTATION_STAGES in app/lib/mutations.ts.
  stage        String?                          // variant|product
  startedAt    DateTime?
  // Touched while a job is actively mutating. A running job whose heartbeat has
  // gone cold is a crashed worker, and is safe to resume.
  heartbeatAt  DateTime?
  error        String?                          // job-level failure message

  @@index([shopId])
  @@index([shopId, status])
  // The orphaned-queue sweep: queued jobs for one shop, oldest first.
  @@index([shopId, status, updatedAt])
}

model Snapshot {
  id        String  @id @default(cuid())
  jobId     String
  ownerGid  String  // product or variant GID
  fieldPath String  // e.g. "variant.price", "product.tags"
  oldValue  String  // JSON-encoded
  newValue  String
  applied   Boolean @default(false)
  error     String?
  job       EditJob @relation(fields: [jobId], references: [id])

  // Parent product of a variant row. productVariantsBulkUpdate is addressed by
  // product, so the mutation builder needs this and must not have to re-query
  // Shopify for it mid-apply.
  productGid String?
  // Line this row occupies in the JSONL of the current bulk stage. Bulk results
  // come back keyed by __lineNumber, so this is how a result finds its row.
  bulkLine   Int?
  // Undo only: the live value no longer matched what the original job wrote,
  // i.e. the product was edited elsewhere in between. The undo still applies.
  drifted    Boolean   @default(false)
  appliedAt  DateTime?

  @@index([jobId])
  @@index([jobId, applied])
}

model SavedTemplate {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  filterJson  Json
  actionsJson Json
  createdAt   DateTime @default(now())

  @@index([shopId])
}
